{
  "name": "maheshlabs-podcast",
  "version": "2.0.0",
  "private": true,
  "description": "The MaheshLabs podcast website, built with Next.js and TypeScript",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check.mjs"
  },
  "engines": {"node": ">=20.9.0"},
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
