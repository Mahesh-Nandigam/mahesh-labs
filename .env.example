# Server-only Neon variables: pulled by neon deploy / neon env pull.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Generate locally with npm run admin:password. Never use NEXT_PUBLIC_ here.
ADMIN_PASSWORD_HASH=

# Public production origin for metadata and sharing links.
NEXT_PUBLIC_SITE_URL=https://maheshlabs.io

# Resend account is managed by the project owner's friend.
# Use a Sending access key restricted to the verified sending domain.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Plain address on that domain, without a display name.
EMAIL_FROM=
EMAIL_REPLY_TO=

# Generate a separate stable secret (32+ characters). Rotating it invalidates
# existing subscriber access and unsubscribe links. Never expose it publicly.
NEWSLETTER_TOKEN_SECRET=

# Optional authenticated queue worker. Connect a scheduler before enabling.
CRON_SECRET=
NEWSLETTER_SCHEDULER_ENABLED=false
